{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile with physical attributes, macro targets, and goals.",
      "type": "object",
      "properties": {
        "heightCm": { "type": "number" },
        "weightKg": { "type": "number" },
        "desiredWeightKg": { "type": "number" },
        "targetCalories": { "type": "number" },
        "maxJunkCaloriePercent": { "type": "number" },
        "goal": { "type": "string" },
        "targetProtein": { "type": "number" },
        "targetCarbs": { "type": "number" },
        "targetFat": { "type": "number" },
        "waterGoal": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["heightCm", "weightKg", "desiredWeightKg", "targetCalories", "maxJunkCaloriePercent", "updatedAt"]
    },
    "FoodItem": {
      "title": "Food Item",
      "description": "A food item logged by the user.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "maxLength": 100 },
        "isJunk": { "type": "boolean" },
        "calories": { "type": "number" },
        "protein": { "type": "number" },
        "carbs": { "type": "number" },
        "fat": { "type": "number" },
        "sugar": { "type": "number" },
        "sodium": { "type": "number" },
        "mealType": { "type": "string" },
        "grade": { "type": "string" },
        "imageUrl": { "type": "string" },
        "portion": { "type": "string" },
        "healthScore": { "type": "number" },
        "swapSuggestion": { "type": "string" },
        "date": { "type": "string", "maxLength": 10, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "name", "isJunk", "calories", "protein", "carbs", "fat", "date", "createdAt", "mealType", "grade"]
    },
    "Recipe": {
      "title": "Saved Recipe",
      "description": "Custom recipe composed by the user with ingredient breakdowns.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "servings": { "type": "number" },
        "caloriesPerServing": { "type": "number" },
        "proteinPerServing": { "type": "number" },
        "carbsPerServing": { "type": "number" },
        "fatPerServing": { "type": "number" },
        "isJunk": { "type": "boolean" },
        "ingredients": { "type": "array" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "name", "servings", "caloriesPerServing", "createdAt"]
    },
    "GroceryItem": {
      "title": "Grocery Shopping Item",
      "description": "Smart grocery list item.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "completed": { "type": "boolean" },
        "source": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "name", "category", "completed", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles"
    },
    "/users/{userId}/foodLogs/{logId}": {
      "schema": { "$ref": "#/entities/FoodItem" },
      "description": "Food items logged by the user"
    },
    "/users/{userId}/recipes/{recipeId}": {
      "schema": { "$ref": "#/entities/Recipe" },
      "description": "Custom meal recipes"
    },
    "/users/{userId}/groceryList/{itemId}": {
      "schema": { "$ref": "#/entities/GroceryItem" },
      "description": "Smart grocery shopping items"
    }
  }
}
